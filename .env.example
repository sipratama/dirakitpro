# Docker Compose — local PostgreSQL
# Copy this file to .env at the repository root before running Docker Compose.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_RESTART_POLICY=unless-stopped
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dirakitpro_dev
POSTGRES_HOST_PORT=5433
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DATA_DIR=/var/lib/postgresql/data
POSTGRES_VOLUME_NAME=dirakitpro_db_data
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10
